# Copy this file to .env and replace the example password.
# SQL Server requires at least 8 characters from 3 of these groups:
# uppercase, lowercase, numbers and symbols.
FINPAY_DB_PASSWORD=ReplaceWithAStrongPassword123!

# Base64-encoded 256-bit JWT signing key. Generate one using the
# Windows PowerShell-compatible command documented in README.md.
FINPAY_JWT_SECRET=

# Optional separate key for encrypting webhook signing secrets.
# If omitted, Docker Compose reuses FINPAY_JWT_SECRET.
FINPAY_WEBHOOK_ENCRYPTION_KEY=

# Development defaults allow HTTP and local/private receiver addresses.
# For production use true and false respectively.
FINPAY_WEBHOOK_REQUIRE_HTTPS=false
FINPAY_WEBHOOK_ALLOW_PRIVATE_ADDRESSES=true

# Host ports. Change them if another application is already using them.
FINPAY_DB_PORT=1434
FINPAY_API_PORT=8080
FINPAY_REDIS_PORT=6379
FINPAY_KAFKA_PORT=9094
FINPAY_FRONTEND_PORT=4200
